---
import datos from "../data/footer.json";
---

<footer>
  <div class="contenido">
    <div class="marca">
      <a class="logo" href="/">Futur<span>Job</span></a>

      <div class="redes">
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"></circle>
          </svg>
        </a>
        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M14 8V6.5c0-.7.3-1 1-1h2V2h-3c-3 0-4.5 1.8-4.5 4.3V8H7v3.5h2.5V22H14V11.5h2.8L17.3 8H14z"></path>
          </svg>
        </a>
      </div>

      <p class="copy">{datos.copyright}</p>
    </div>

    <div class="columnas">
      {datos.columnas.map((col) => (
        <div class="columna">
          <h3>{col.titulo}</h3>
          {col.enlaces.map((link) => (
            <a href={link.enlace}>{link.texto}</a>
          ))}
        </div>
      ))}
    </div>
  </div>
</footer>

<style>
  footer {
    background: #2a3f9d;
    color: #ffffff;
    padding: 2.5rem 5% 2rem;
  }

  .contenido {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .marca {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
  }

  .logo span {
    color: #c9d6ff;
  }

  .redes {
    display: flex;
    gap: 0.75rem;
  }

  .redes a {
    color: #ffffff;
  }

  .redes svg {
    display: block;
    width: 22px;
    height: 22px;
  }

  .copy {
    margin: 1.5rem 0 0;
    font-size: 0.65rem;
    color: #c9d6ff;
  }

  .columnas {
    display: flex;
    gap: 3rem;
  }

  .columna {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  h3 {
    margin: 0 0 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .columna a {
    font-size: 0.65rem;
    color: #c9d6ff;
  }

  .columna a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .contenido {
      flex-direction: column;
    }

    .columnas {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .columna a {
      font-size: 0.78rem;
    }

    h3 {
      font-size: 0.85rem;
    }

    .copy {
      font-size: 0.72rem;
    }
  }
</style>